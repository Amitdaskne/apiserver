<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- BRANDING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWERED BY AMIT"
            android:textColor="@color/cyber_pink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- BUTTONS (Start + Stop side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="▶ INITIALIZE"
                android:textColor="@color/cyber_bg"
                android:backgroundTint="@color/cyber_cyan"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="■ SHUTDOWN"
                android:textColor="@color/cyber_bg"
                android:backgroundTint="@color/cyber_pink"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:enabled="false"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- PUBLIC URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ PUBLIC UPLINK ]"
            android:textColor="@color/cyber_pink"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/urlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/cyber_panel"
            android:textColor="@color/cyber_cyan"
            android:fontFamily="monospace"
            android:text="OFFLINE. Awaiting initialization..."
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/copyBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ COPY URL ]"
            android:textColor="@color/cyber_cyan"
            android:backgroundTint="@color/cyber_panel"
            android:fontFamily="monospace"
            android:enabled="false"
            android:layout_marginTop="8dp"/>

        <!-- CONNECTION GUIDE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ CONNECTION GUIDE ]"
            android:textColor="@color/cyber_pink"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/cyber_panel"
            android:textColor="@color/cyber_text"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:text="Test in Browser:\nhttps://your-url.trycloudflare.com/api/ping\n\nHTML/JS Code:\n\nfetch('https://your-url.trycloudflare.com/api/notes')\n  .then(r => r.json())\n  .then(d => console.log(d));"/>

        <!-- LIVE LOGS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ SYSTEM LOGS ]"
            android:textColor="@color/cyber_pink"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/cyber_panel"
            android:textColor="@color/cyber_green"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
