<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">
        
        <TextView
            android:id="@+id/brandingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POWERED BY AMIT"
            android:textColor="@color/cyber_pink"
            android:textSize="24sp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="[ INITIALIZE SYSTEM ]"
            android:textColor="@color/cyber_bg"
            android:backgroundTint="@color/cyber_cyan"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>
            
        <Button
            android:id="@+id/stopBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="[ SHUTDOWN SYSTEM ]"
            android:textColor="@color/cyber_bg"
            android:backgroundTint="@color/cyber_pink"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:visibility="gone"/> <!-- Default me hidden -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ PUBLIC UPLINK ]"
            android:textColor="@color/cyber_pink"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="30dp"/>
            
        <TextView
            android:id="@+id/urlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/cyber_panel"
            android:textColor="@color/cyber_cyan"
            android:fontFamily="monospace"
            android:text="SYSTEM OFFLINE..."
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
            
        <Button
            android:id="@+id/copyBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ EXPORT link.amit ]"
            android:textColor="@color/cyber_cyan"
            android:backgroundTint="@color/cyber_panel"
            android:fontFamily="monospace"
            android:enabled="false"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ SYSTEM LOGS ]"
            android:textColor="@color/cyber_pink"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="30dp"/>
            
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@color/cyber_panel"
            android:textColor="@color/cyber_green"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
